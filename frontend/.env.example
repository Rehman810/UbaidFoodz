# Local dev — API on localhost
NEXT_PUBLIC_API_URL=http://localhost:4000

# Vercel production (recommended):
# - Remove NEXT_PUBLIC_API_URL (or leave unset) → uses /api/proxy same-origin
# - Set server env: API_PROXY_TARGET=http://80.225.219.189:4000
# - Optional live sockets: NEXT_PUBLIC_SOCKET_URL=https://your-https-tunnel-or-domain
