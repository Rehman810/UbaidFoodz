DATABASE_URL="postgresql://ubaid:ubaid@localhost:5432/ubaidfastfoodz?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CLIENT_URL="http://localhost:3000,http://localhost:3001"

# Optional — Gmail: use an App Password, not your normal password (16 letters, no spaces)
SMTP_SERVICE="gmail"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your16charapppassword"
SMTP_FROM="Ubaid Fast Foodz <your-email@gmail.com>"
# Optional extra inbox for new-order alerts (in addition to admin/chef accounts)
NOTIFY_EMAIL=""

# Meta WhatsApp Cloud API — https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ENABLED="true"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LANG="en"
# Kitchen alert number (defaults to store WhatsApp in admin settings)
WHATSAPP_NOTIFY_TO="923215556677"
# Approved templates in Meta Business Manager (required for first message to customers)
WHATSAPP_TEMPLATE_ORDER="order_received"
WHATSAPP_TEMPLATE_STAFF="new_order_alert"
