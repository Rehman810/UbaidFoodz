generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  RIDER
}

enum OrderStatus {
  AWAITING_CONFIRMATION
  PENDING
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  createdAt    DateTime @default(now())

  orders         Order[] @relation("CustomerOrders")
  assignedOrders Order[] @relation("RiderOrders")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  tagline   String   @default("")
  imageUrl  String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model MenuItem {
  id            String          @id @default(uuid())
  name          String
  description   String
  price         Decimal         @db.Decimal(10, 2)
  discountPrice Decimal?        @db.Decimal(10, 2)
  category      String
  imageUrl      String
  isAvailable   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orderItems    OrderItem[]
  dealItems     DealItem[]
  sizes         MenuItemSize[]
  addons        MenuItemAddon[]
  optionGroups  MenuItemOptionGroup[]
}

model MenuItemOptionGroup {
  id         String           @id @default(uuid())
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean          @default(true)
  sortOrder  Int              @default(0)
  options    MenuItemOption[]

  @@unique([menuItemId, name])
}

model MenuItemOption {
  id            String              @id @default(uuid())
  groupId       String
  group         MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  price         Decimal             @db.Decimal(10, 2)
  discountPrice Decimal?            @db.Decimal(10, 2)
  sortOrder     Int                 @default(0)

  @@unique([groupId, name])
}

model MenuItemSize {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  @@unique([menuItemId, name])
}

model MenuItemAddon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  @@unique([menuItemId, name])
}

model StoreSettings {
  id                  String   @id @default("default")
  phone               String   @default("0321-5556677")
  whatsapp            String   @default("923215556677")
  address             String   @default("Boat Basin, Clifton Block 5, Karachi")
  latitude            Decimal? @db.Decimal(10, 7)
  longitude           Decimal? @db.Decimal(10, 7)
  minimumOrder        Decimal  @default(500) @db.Decimal(10, 2)
  freeDeliveryAbove   Decimal? @db.Decimal(10, 2)
  deliveryEstimateMin Int      @default(45)
  pickupEstimateMin   Int      @default(20)
  openHour            Int      @default(19)
  openMinute          Int      @default(0)
  closeHour           Int      @default(2)
  closeMinute         Int      @default(30)
  closedMessage       String   @default("Sorry, we are closed right now. We open daily at 7:00 PM.")
  forceClosed         Boolean  @default(false)
  autoConfirmOrders   Boolean  @default(false)
  facebookUrl         String   @default("")
  instagramUrl        String   @default("")
  tiktokUrl           String   @default("")
  youtubeUrl          String   @default("")
  updatedAt           DateTime @updatedAt
}

model PromoBanner {
  id        String   @id @default(uuid())
  title     String   @default("")
  imageUrl  String
  linkUrl   String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Deal {
  id          String     @id @default(uuid())
  title       String
  description String     @default("")
  dealPrice   Decimal    @db.Decimal(10, 2)
  imageUrl    String     @default("")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       DealItem[]
}

model DealItem {
  id         String   @id @default(uuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)

  @@unique([dealId, menuItemId])
}

model DeliveryArea {
  id             String   @id @default(uuid())
  name           String   @unique
  deliveryCharge Decimal  @db.Decimal(10, 2)
  isDelivering   Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  orders         Order[]
}

model Order {
  id               String          @id @default(uuid())
  orderNumber      String          @unique
  customerId       String?
  customer         User?           @relation("CustomerOrders", fields: [customerId], references: [id])
  guestAccessToken String?         @unique
  riderId          String?
  rider            User?           @relation("RiderOrders", fields: [riderId], references: [id])
  status           OrderStatus     @default(PENDING)
  fulfillmentType  FulfillmentType @default(DELIVERY)
  deliveryAreaId   String?
  deliveryArea     DeliveryArea?   @relation(fields: [deliveryAreaId], references: [id])
  subtotal         Decimal         @db.Decimal(10, 2)
  deliveryCharge   Decimal         @default(0) @db.Decimal(10, 2)
  total            Decimal         @db.Decimal(10, 2)
  deliveryAddress  String
  notes            String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            OrderItem[]
  invoice          Invoice?
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  quantity      Int
  priceAtOrder  Decimal  @db.Decimal(10, 2)
  nameAtOrder   String
  optionsLabel  String   @default("")
  instructions  String   @default("")
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  generatedAt   DateTime @default(now())
  pdfPath       String
}
