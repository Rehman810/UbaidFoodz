generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One deployment serves one restaurant. Every tenant row carries this id.
model Restaurant {
  id        String   @id
  hostname  String?  @unique
  createdAt DateTime @default(now())

  settings     StoreSettings?
  users        User[]
  categories   Category[]
  menuItems    MenuItem[]
  banners      PromoBanner[]
  deals        Deal[]
  areas        DeliveryArea[]
  branches     Branch[]
  orders       Order[]
  blocks       OrderBlock[]
  testimonials Testimonial[]
}

model Branch {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  code         String
  address      String     @default("")
  phone        String     @default("")
  isActive     Boolean    @default(true)
  isDefault    Boolean    @default(false)
  sortOrder    Int        @default(0)
  timezone     String     @default("Asia/Karachi")
  graceMin     Int        @default(15)
  createdAt    DateTime   @default(now())
  orders         Order[]
  auditLogs      AuditLog[]
  members        BranchMember[]
  diningFloors   DiningFloor[]
  diningTables   DiningTable[]
  tableSessions  TableSession[]
  reservations   Reservation[]
  waitlistEntries WaitlistEntry[]

  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
}

model BranchMember {
  id       String @id @default(uuid())
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([branchId, userId])
  @@index([userId])
}

enum Role {
  CUSTOMER
  ADMIN
  MANAGER
  WAITER
  RIDER
  CHEF
  CASHIER
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  NEEDS_CLEANING
}

enum SeatType {
  TABLE
  TAKHT
  BOOTH
  HIGH_TOP
  OUTDOOR
}

enum TableSessionStatus {
  OPEN
  CLOSED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  REJECTED
  SEATED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum WaitlistStatus {
  WAITING
  CALLED
  SEATED
  CANCELLED
  LEFT
}

enum OrderSource {
  ONLINE
  POS
}

enum PaymentMethod {
  CASH
  CARD
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COLLECTED
  SERVED
  CANCELLED
}

enum FulfillmentType {
  DELIVERY
  PICKUP
  DINE_IN
}

model User {
  id           String   @id @default(uuid())
  restaurantId String   @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  phone        String?
  isActive     Boolean  @default(true)
  totpSecret           String?
  totpEnabled          Boolean   @default(false)
  recoveryCodes        String?
  tokenVersion         Int       @default(0)
  failedLoginCount     Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())

  orders          Order[]        @relation("CustomerOrders")
  assignedOrders  Order[]        @relation("RiderOrders")
  posOrders       Order[]        @relation("PosOrders")
  waiterOrders    Order[]        @relation("WaiterOrders")
  waiterSessions       TableSession[] @relation("WaiterSessions")
  branchMembers        BranchMember[]
  confirmedReservations Reservation[] @relation("ReservationConfirmedBy")
  auditLogs            AuditLog[]
}

model DiningFloor {
  id        String        @id @default(uuid())
  branchId  String
  branch    Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  tables    DiningTable[]

  @@unique([branchId, name])
  @@index([branchId, sortOrder])
}

model DiningTable {
  id           String      @id @default(uuid())
  branchId     String
  branch       Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floorId      String?
  floor        DiningFloor? @relation(fields: [floorId], references: [id], onDelete: SetNull)
  label        String
  capacity     Int         @default(4)
  seatType     SeatType    @default(TABLE)
  zone         String      @default("")
  status       TableStatus @default(AVAILABLE)
  sortOrder    Int         @default(0)
  createdAt    DateTime    @default(now())
  sessions     TableSession[]
  reservations Reservation[]
  orders       Order[]
  waitlistPreferred WaitlistEntry[] @relation("WaitlistPreferredTable")

  @@unique([branchId, label])
  @@index([branchId, status])
  @@index([floorId])
}

model TableSession {
  id            String             @id @default(uuid())
  branchId      String
  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId       String
  table         DiningTable        @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiterId      String?
  waiter        User?              @relation("WaiterSessions", fields: [waiterId], references: [id])
  guestName     String             @default("Walk-in")
  partySize     Int                @default(2)
  status        TableSessionStatus @default(OPEN)
  notes         String?
  openedAt      DateTime           @default(now())
  closedAt      DateTime?
  reservationId String?            @unique
  reservation   Reservation?       @relation(fields: [reservationId], references: [id])
  orders        Order[]

  @@index([branchId, status])
  @@index([tableId, status])
}

model Reservation {
  id                 String            @id @default(uuid())
  branchId           String
  branch             Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tableId            String?
  table              DiningTable?      @relation(fields: [tableId], references: [id])
  guestName          String
  guestPhone         String
  guestEmail         String
  emailMissingLegacy Boolean           @default(false)
  partySize          Int               @default(2)
  startsAt           DateTime
  durationMin        Int               @default(90)
  status             ReservationStatus @default(PENDING)
  notes              String?
  confirmedAt        DateTime?
  confirmedById      String?
  confirmedBy        User?             @relation("ReservationConfirmedBy", fields: [confirmedById], references: [id])
  rejectedAt         DateTime?
  rejectionReason    String?
  noShowAt           DateTime?
  cancelledAt        DateTime?
  confirmationToken  String            @unique
  idempotencyKey     String?           @unique
  reminderSentAt     DateTime?
  followUpSentAt     DateTime?
  createdAt          DateTime          @default(now())
  session            TableSession?
  emailLogs          EmailLog[]

  @@index([branchId, startsAt])
  @@index([branchId, status])
  @@index([branchId, status, startsAt])
}

model WaitlistEntry {
  id                 String         @id @default(uuid())
  branchId           String
  branch             Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  queueDate          String
  queueNumber        Int
  guestName          String
  guestPhone         String?
  partySize          Int            @default(2)
  preferredSeatType  SeatType?
  preferredTableId   String?
  preferredTable     DiningTable?   @relation("WaitlistPreferredTable", fields: [preferredTableId], references: [id], onDelete: SetNull)
  status             WaitlistStatus @default(WAITING)
  notes              String?
  createdAt          DateTime       @default(now())
  calledAt           DateTime?
  seatedAt           DateTime?
  tableSessionId     String?        @unique

  @@unique([branchId, queueDate, queueNumber])
  @@index([branchId, status, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([branchId, createdAt])
  @@index([entity, entityId])
}

model EmailLog {
  id            String       @id @default(uuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  type          String
  toEmail       String
  status        String       @default("PENDING")
  error         String?
  attempts      Int          @default(0)
  sentAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([reservationId, type])
  @@index([status, createdAt])
}

model Category {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String     @unique
  tagline   String   @default("")
  imageUrl  String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model MenuItem {
  id            String          @id @default(uuid())
  restaurantId  String          @default("11111111-1111-4111-8111-111111111111")
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id])
  name          String
  description   String
  price         Decimal         @db.Decimal(10, 2)
  discountPrice Decimal?        @db.Decimal(10, 2)
  category      String
  imageUrl      String
  isAvailable   Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orderItems    OrderItem[]
  dealItems     DealItem[]
  sizes         MenuItemSize[]
  addons        MenuItemAddon[]
  optionGroups  MenuItemOptionGroup[]
}

model MenuItemOptionGroup {
  id         String           @id @default(uuid())
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean          @default(true)
  sortOrder  Int              @default(0)
  options    MenuItemOption[]

  @@unique([menuItemId, name])
}

model MenuItemOption {
  id            String              @id @default(uuid())
  groupId       String
  group         MenuItemOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name          String
  price         Decimal             @db.Decimal(10, 2)
  discountPrice Decimal?            @db.Decimal(10, 2)
  sortOrder     Int                 @default(0)

  @@unique([groupId, name])
}

model MenuItemSize {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  @@unique([menuItemId, name])
}

model MenuItemAddon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  sortOrder  Int      @default(0)

  @@unique([menuItemId, name])
}

model StoreSettings {
  id                  String   @id @default("default")
  restaurantId        String   @unique @default("11111111-1111-4111-8111-111111111111")
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id])
  storeName           String   @default("")
  storeTagline        String   @default("Order in minutes")
  logoUrl             String   @default("")
  faviconUrl          String   @default("")
  primaryColor        String   @default("#ea580c")
  accentColor         String   @default("#c2410c")
  city                String   @default("")
  timezone            String   @default("Asia/Karachi")
  currencyCode        String   @default("PKR")
  currencySymbol      String   @default("Rs")
  footerText          String   @default("")
  poweredByText       String   @default("")
  poweredByUrl        String   @default("")
  showPoweredBy       Boolean  @default(false)
  showLiveStats       Boolean  @default(false)
  phone               String   @default("")
  whatsapp            String   @default("")
  address             String   @default("")
  latitude            Decimal? @db.Decimal(10, 7)
  longitude           Decimal? @db.Decimal(10, 7)
  minimumOrder        Decimal  @default(500) @db.Decimal(10, 2)
  freeDeliveryAbove   Decimal? @db.Decimal(10, 2)
  deliveryEstimateMin Int      @default(45)
  pickupEstimateMin   Int      @default(20)
  openHour            Int      @default(19)
  openMinute          Int      @default(0)
  closeHour           Int      @default(2)
  closeMinute         Int      @default(30)
  weeklySchedule      Json?
  closedMessage       String   @default("")
  forceClosed         Boolean  @default(false)
  taxPercent          Decimal  @default(0) @db.Decimal(5, 2)
  taxLabel            String   @default("Tax")
  taxIncluded         Boolean  @default(false)
  serviceChargePercent Decimal @default(0) @db.Decimal(5, 2)
  serviceChargeLabel  String   @default("Service charge")
  serviceIncluded     Boolean  @default(false)
  acceptCash          Boolean  @default(true)
  acceptCard          Boolean  @default(true)
  taxNumber           String   @default("")
  receiptFooter       String   @default("")
  confirmSlaMinutes   Int      @default(15)
  deliverySlaMinutes  Int      @default(45)
  autoConfirmOrders   Boolean  @default(false)
  autoAssignRiders    Boolean  @default(true)
  emailNotifyChef     Boolean  @default(true)
  emailNotifyCashier  Boolean  @default(true)
  emailNotifyRider    Boolean  @default(true)
  facebookUrl         String   @default("")
  instagramUrl        String   @default("")
  tiktokUrl           String   @default("")
  youtubeUrl          String   @default("")
  googlePlaceId       String   @default("")
  updatedAt           DateTime @updatedAt
}

model PromoBanner {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  title        String     @default("")
  imageUrl  String
  linkUrl   String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Deal {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  title        String
  description String     @default("")
  category    String     @default("")
  dealPrice   Decimal    @db.Decimal(10, 2)
  imageUrl    String     @default("")
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       DealItem[]
}

model DealItem {
  id         String   @id @default(uuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int      @default(1)

  @@unique([dealId, menuItemId])
}

model DeliveryArea {
  id             String     @id @default(uuid())
  restaurantId   String     @default("11111111-1111-4111-8111-111111111111")
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id])
  name           String     @unique
  deliveryCharge Decimal  @db.Decimal(10, 2)
  isDelivering   Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  orders         Order[]
}

model Order {
  id               String          @id @default(uuid())
  restaurantId     String          @default("11111111-1111-4111-8111-111111111111")
  restaurant       Restaurant      @relation(fields: [restaurantId], references: [id])
  branchId         String?
  branch           Branch?         @relation(fields: [branchId], references: [id])
  orderNumber      String          @unique
  customerId       String?
  customer         User?           @relation("CustomerOrders", fields: [customerId], references: [id])
  createdById      String?
  createdBy        User?           @relation("PosOrders", fields: [createdById], references: [id])
  guestAccessToken String?         @unique
  riderId          String?
  rider            User?           @relation("RiderOrders", fields: [riderId], references: [id])
  diningTableId    String?
  diningTable      DiningTable?    @relation(fields: [diningTableId], references: [id])
  tableSessionId   String?
  tableSession     TableSession?   @relation(fields: [tableSessionId], references: [id])
  waiterId         String?
  waiter           User?           @relation("WaiterOrders", fields: [waiterId], references: [id])
  status           OrderStatus     @default(PENDING_CONFIRMATION)
  orderSource      OrderSource     @default(ONLINE)
  paymentMethod    PaymentMethod?
  paymentStatus    String          @default("PAID")
  tableNumber      String?
  fulfillmentType  FulfillmentType @default(DELIVERY)
  deliveryAreaId   String?
  deliveryArea     DeliveryArea?   @relation(fields: [deliveryAreaId], references: [id])
  subtotal         Decimal         @db.Decimal(10, 2)
  deliveryCharge   Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(10, 2)
  serviceAmount    Decimal         @default(0) @db.Decimal(10, 2)
  total            Decimal         @db.Decimal(10, 2)
  deliveryAddress  String
  notes            String?
  customerName     String
  customerPhone    String
  customerEmail    String?
  customerIp       String?
  customerLatitude  Decimal?       @db.Decimal(10, 7)
  customerLongitude Decimal?       @db.Decimal(10, 7)
  customerLocationAccuracy Decimal? @db.Decimal(10, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            OrderItem[]
  invoice          Invoice?
  events           OrderEvent[]
}

model OrderEvent {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actorId    String?
  actorRole  String?
  reason     String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id])
  quantity      Int
  priceAtOrder  Decimal  @db.Decimal(10, 2)
  nameAtOrder   String
  optionsLabel  String   @default("")
  instructions  String   @default("")
}

model OrderBlock {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  email        String?
  phone     String?
  reason    String   @default("")
  createdAt DateTime @default(now())
  createdBy String?

  @@index([email])
  @@index([phone])
}

model Testimonial {
  id           String     @id @default(uuid())
  restaurantId String     @default("11111111-1111-4111-8111-111111111111")
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  area         String     @default("")
  text         String
  rating       Int        @default(5)
  isPublished  Boolean    @default(true)
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([restaurantId, isPublished])
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  generatedAt   DateTime @default(now())
  pdfPath       String
}
